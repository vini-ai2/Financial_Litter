generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String
  creditScore   Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  bills         Bill[]
  budgets       Budget[]
  incomeSources IncomeSource[]
  investments   Investment[]
  stockTrades   StockTrade[]
  loans         Loan[]
  monthlySnapshots MonthlySnapshot[]
  sessions      Session[]
}

model MonthlySnapshot {
  id               String   @id @default(cuid())
  userId           String
  year             Int
  month            Int
  totalAssets      Decimal
  totalLiabilities Decimal
  netWorth         Decimal
  capturedAt       DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id])

  @@unique([userId, year, month])
  @@index([userId, capturedAt])
}

model IncomeSource {
  id             String           @id @default(uuid())
  userId         String
  name           String
  type           IncomeSourceType
  amount         Decimal
  frequency      IncomeFrequency
  effectiveFrom  DateTime
  effectiveUntil DateTime?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @unique
  userAgent        String?
  createdAt        DateTime @default(now())
  expiresAt        DateTime
  user             User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Account {
  id           String        @id @default(uuid())
  userId       String
  name         String
  type         AccountType
  balance      Decimal
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id          String          @id @default(uuid())
  accountId   String
  amount      Decimal
  type        TransactionType
  category    String
  date        DateTime
  createdAt   DateTime        @default(now())
  description String          @default("")
  account     Account         @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([date])
}

model Loan {
  id           String   @id @default(uuid())
  userId       String
  type         LoanType
  principal    Decimal
  interestRate Decimal
  tenureMonths Int
  emiAmount    Decimal
  outstanding  Decimal
  startDate    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Investment {
  id             String             @id @default(uuid())
  userId         String
  category       InvestmentCategory
  name           String
  investedAmount Decimal
  currentValue   Decimal
  purchaseDate   DateTime
  createdAt      DateTime           @default(now())
  user           User               @relation(fields: [userId], references: [id])

  @@index([userId])
}

model StockTrade {
  id                    String          @id @default(uuid())
  userId                String
  exchange              StockExchange
  symbol                String          @db.VarChar(20)
  companyName           String?         @db.VarChar(120)
  side                  StockTradeSide
  quantity              Int
  executionPrice        Decimal         @db.Decimal(20, 6)
  fees                  Decimal         @db.Decimal(20, 2)
  tradeDate             DateTime        @db.Date
  createdAt             DateTime        @default(now())
  reversesTransactionId String?         @unique
  correctionReason      String?         @db.VarChar(500)
  user                  User            @relation(fields: [userId], references: [id])
  reversesTransaction   StockTrade?     @relation("StockTradeReversals", fields: [reversesTransactionId], references: [id], onDelete: Restrict)
  reversal              StockTrade?     @relation("StockTradeReversals")

  @@index([userId, exchange, symbol, tradeDate, createdAt])
  @@index([userId, createdAt])
}

model Bill {
  id         String     @id @default(uuid())
  userId     String
  name       String
  amount     Decimal
  category   String
  dueDate    DateTime
  recurrence Recurrence
  isPaid     Boolean    @default(false)
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([dueDate])
}

model Budget {
  id            String   @id @default(uuid())
  userId        String
  goalName      String
  targetAmount  Decimal
  currentAmount Decimal  @default(0)
  targetDate    DateTime
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum AccountType {
  CHECKING
  SALARY
  SAVINGS
  FD
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum LoanType {
  HOME
  AUTO
  GOLD
  PERSONAL
}

enum InvestmentCategory {
  EQUITY_LARGE
  EQUITY_MID
  EQUITY_SMALL
  FIXED_INCOME
  ETF
  MUTUAL_FUND
}

enum StockExchange {
  NSE
  BSE
}

enum StockTradeSide {
  BUY
  SELL
}

enum Recurrence {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum IncomeSourceType {
  SALARY
  FREELANCE
  RENTAL
  OTHER
}

enum IncomeFrequency {
  WEEKLY
  MONTHLY
  ANNUAL
}
